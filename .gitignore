# Local configuration may contain absolute paths on your machine.
config.json

# Runtime data: user media, transcripts and intermediate audio.
inbox/*
output/*
work/*
!inbox/.gitkeep
!output/.gitkeep
!work/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# V1.1: portable runtime payload, build inputs and resumable downloads
runtime/
release_assets/
*.part
SHA256SUMS.txt

# Model weights and packaged builds must never be committed.
models/
dist/
build/
*.zip
*.7z
